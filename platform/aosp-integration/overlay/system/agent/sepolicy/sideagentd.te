type sideagentd, domain, coredomain;
type sideagentd_exec, exec_type, system_file_type, file_type;
type sideagentd_data_file, file_type, data_file_type, core_data_file_type;
type sideagentd_secret_file, file_type, data_file_type, core_data_file_type;
type sideagent_service, service_manager_type;
type agentos_service, system_server_service, service_manager_type;

init_daemon_domain(sideagentd)
net_domain(sideagentd)
allow sideagentd sideagentd_data_file:dir create_dir_perms;
allow sideagentd sideagentd_data_file:file create_file_perms;
allow sideagentd sideagentd_data_file:dir { add_name remove_name write search getattr open };
allow sideagentd sideagentd_data_file:file { create open read write getattr rename unlink setattr };
allow sideagentd sideagentd_secret_file:file { open read getattr };
binder_use(sideagentd)
add_service(sideagentd, sideagent_service)
allow system_server sideagent_service:service_manager find;
binder_call(system_server, sideagentd)
allow shell agentos_service:service_manager find;

# Do not grant app Binder access in this bootstrap slice. The capability
# endpoint policy is added only with the versioned Plugin AIDL and its tests.
