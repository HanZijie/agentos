// Bootstrap overlay for the AgentOS system slice.
// Add system/agent to PRODUCT_SOONG_NAMESPACES in the selected AOSP product.
// This module is intentionally separate from the reference Node runtime in
// the repository's system/agent/daemon directory.
soong_namespace {
    imports: [],
}

aidl_interface {
    name: "agentos_system_aidl",
    owner: "agentos",
    srcs: [
        "com/example/agentos/*.aidl",
    ],
    // The frontend/session methods are still being exercised on the target
    // image. Keep the current surface buildable while the next API version is
    // frozen.
    frozen: false,
    stability: "vintf",
    versions_with_info: [
        {
            version: "1",
        },
        {
            version: "2",
        },
    ],
    backend: {
        cpp: { enabled: false },
        java: { enabled: true },
        ndk: { enabled: true },
    },
}

cc_binary {
    name: "sideagentd",
    srcs: ["sideagentd/main.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
    ],
    static_libs: ["agentos_system_aidl-ndk"],
    init_rc: ["init/sideagentd.rc"],
    // The init rc uses /system/bin/sideagentd. Keep this system-installed
    // until a product-specific path is selected and recorded in the rc.
    product_specific: false,
    cflags: ["-DLOG_TAG=\"sideagentd\""],
}
