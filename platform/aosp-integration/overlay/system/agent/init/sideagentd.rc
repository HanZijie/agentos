service sideagentd /system/bin/sideagentd
    class core
    user sideagent
    group sideagent
    seclabel u:r:sideagentd:s0

# Keep the process under init supervision. The daemon owns no model or Plugin
# state yet; the next slice adds durable state and Binder reconnect handling.
on property:sys.boot_completed=1
    restart sideagentd
