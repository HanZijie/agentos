{
  "schema": 1,
  "targetPartition": "system",
  "productPackagePolicy": "runtime processes are separate from system_server",
  "runtimes": [
    {
      "id": "native",
      "status": "integrated",
      "source": "system/agent/sideagentd/runtime_worker.cpp",
      "artifact": "",
      "module": "sideagentd",
      "integrated": true,
      "abi": ["x86_64", "arm64-v8a"],
      "entrypoint": "system/bin/sideagentd"
    },
    {
      "id": "pi",
      "status": "reference_only",
      "source": "runtime/src/pi-worker.js",
      "artifact": "",
      "module": "agentos_pi_runtime_bundle",
      "abi": ["portable-js"],
      "entrypoint": "system/etc/agentos/pi-runtime.bundle.js"
    }
  ]
}
