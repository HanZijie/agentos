# Copy to a deployment-only secret location. Never commit the real key.
# The native Android sideagentd reads these names from
# /data/agent/secrets/agent.env. Keep this file mode 0600 and deployment-only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic/v1/messages
MINIMAX_MODEL=MiniMax-M3
JEV_API_KEY=
JEV_ENDPOINT=https://omnilabs.vibeadmin.cn/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1500
# The reference Node selector uses these AGENTOS_* names in its process env.
AGENTOS_JEV_API_KEY=
AGENTOS_JEV_ENDPOINT=https://omnilabs.vibeadmin.cn/v1/systemone
AGENTOS_JEV_MODEL=jev-1.13.0
AGENTOS_JEV_TIMEOUT_MS=1500
AGENTOS_JEV_INPUT_TOKENS=16384
AGENTOS_JEV_OUTPUT_TOKENS=64
AGENTOS_JEV_MIN_RECENT_SESSIONS=20
