<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.example.agenriod.permission.BIND_AGENT_PLUGIN" />
    <queries><package android:name="com.example.agenriod" /></queries>
    <application android:name=".NotesApplication" android:theme="@android:style/Theme.DeviceDefault.Light" android:label="@string/app_name">
        <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>
        <service android:name=".NotesPluginService" android:exported="true" android:permission="com.example.agenriod.permission.BIND_AGENT_PLUGIN">
            <intent-filter><action android:name="com.example.agenriod.action.AGENT_PLUGIN" /></intent-filter>
            <meta-data android:name="com.example.agenriod.PLUGIN_ID" android:value="notes" />
        </service>
    </application>
</manifest>
